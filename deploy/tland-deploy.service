[Unit]
Description=Deploy Riverside Town from the repository
Documentation=https://github.com/quts/tland/blob/main/DEPLOY-EC2.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
# Building an image on a small instance is not quick, and a half-finished
# deploy is worse than a slow one.
TimeoutStartSec=1800
ExecStart=/home/ec2-user/tland/scripts/ec2-deploy.sh

[Install]
WantedBy=multi-user.target
