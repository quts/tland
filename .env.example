# Public port for the web service (nginx). http://localhost:${WEB_PORT}
WEB_PORT=8080

# Game server (internal). The web service reverse-proxies /ws to this.
GAME_PORT=3000

# Room limits
MAX_PLAYERS=50
TICK_HZ=20

# Absolute WebSocket URL of the game server, for split deployments where the
# static client and the game server are on different hosts. Read at BUILD
# time by the client (it is a VITE_ variable), so changing it needs a rebuild.
# Leave empty for the container deployment, where nginx proxies /ws on the
# same origin.
#   VITE_GAME_WS_URL=wss://town-game.example.com
VITE_GAME_WS_URL=

# Chat limits
CHAT_MAX_LENGTH=120
CHAT_RATE_LIMIT_MESSAGES=5
CHAT_RATE_LIMIT_WINDOW_MS=10000
