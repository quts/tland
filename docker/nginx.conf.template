# Static client + WebSocket reverse proxy for the game server.
#
# Rendered at container start by nginx:alpine's envsubst entrypoint. Only
# ${GAME_UPSTREAM} is substituted (NGINX_ENVSUBST_FILTER pins that), so nginx's
# own $variables below are left alone. The upstream host differs between Docker
# Compose (`game`) and the Apple Container scripts (`tland-game`), and this is
# the one knob that varies.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream game_server {
    server ${GAME_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml;

    # Hashed build output is immutable; the entry document never is.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /fonts/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location /ws {
        proxy_pass http://game_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A quiet socket must survive: the game pings every 10s, but a
        # backgrounded iOS tab can go silent for much longer.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location = /healthz {
        proxy_pass http://game_server/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
