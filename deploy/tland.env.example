# Copy to /etc/tland.env on the instance. Read by scripts/ec2-deploy.sh.
#
#   sudo cp deploy/tland.env.example /etc/tland.env
#   sudo nano /etc/tland.env

# Origins allowed to open a WebSocket. Comma-separated, scheme included, no
# trailing slash. WebSocket upgrades are not subject to CORS, so without this
# any page anywhere can use your server as its backend.
ALLOWED_ORIGINS=https://town.example.com,https://your-app.vercel.app

# Where the deployment checkout lives, and what it tracks.
TLAND_REPO=/home/ec2-user/tland
TLAND_BRANCH=main

# Published port. Loopback only; Caddy is what faces the internet.
TLAND_PORT=3000
